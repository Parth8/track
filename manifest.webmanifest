{
  "name": "Track: live trains and flights",
  "short_name": "Track",
  "description": "Live Indian train running status and worldwide flight tracking: your stop, delays, platforms, gates and baggage belts. No ads, no cookies, no sign-ups.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf7f2",
  "theme_color": "#faf7f2",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "travel",
    "navigation"
  ],
  "lang": "en",
  "screenshots": [
    {
      "src": "screenshots/home.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Pick a train or a flight to track"
    },
    {
      "src": "screenshots/train.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Your stop, with the live delay and time left"
    },
    {
      "src": "screenshots/flight.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "A flight in the air, with its live position, altitude and speed"
    },
    {
      "src": "screenshots/wide.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Live flight tracking on a computer"
    }
  ]
}
